generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  cpf               String    @unique
  phone             String
  /** Aceitou receber avisos do pedido pelo WhatsApp (exigência da Meta e da LGPD). */
  whatsappOptIn     Boolean   @default(false)
  birthDate         DateTime
  passwordHash      String
  /** CPF com dígitos válidos e único: suficiente para comprar. */
  cpfCheckedAt      DateTime?
  /**
   * Conta de recebimento aprovada (documentos + selfie analisados pelo gateway,
   * ou aprovação manual do admin). Obrigatório para RECEBER; anunciar só exige
   * a conta de recebimento criada.
   */
  verifiedAt        DateTime?
  /** Subconta do vendedor no gateway, com Conta Escrow ligada. */
  gatewayAccountId  String?
  gatewayWalletId   String?
  /** Chave de API da subconta, criptografada (usada para buscar o link de documentos). */
  gatewayApiKeyEnc  String?
  /** Link do gateway para o vendedor enviar documento e selfie. */
  gatewayOnboardingUrl String?
  gatewayAccountStatus GatewayAccountStatus @default(NENHUM)
  isAdmin           Boolean   @default(false)
  /** Conta bloqueada pelo admin (ex.: fraude): não entra, não compra, não vende. */
  blockedAt         DateTime?
  blockedReason     String?
  /**
   * Saque automático: quando há saldo a enviar da conta de recebimento para a
   * chave Pix CPF do vendedor. Também serve de trava (a rotina adia ao pegar).
   */
  withdrawalDueAt   DateTime?
  createdAt         DateTime  @default(now())

  listings    Listing[]
  withdrawals SellerWithdrawal[]
  orders      Order[]      @relation("BuyerOrders")
  wantedPosts WantedPost[]
  messages    Message[]
  sessions    Session[]
  partnerMemberships PartnerMember[]
}

model Session {
  /** Hash SHA-256 do token do cookie; o token em si nunca é salvo. */
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum GatewayAccountStatus {
  NENHUM
  /** Criada; documentos em análise. Já pode anunciar (com limite). */
  EM_ANALISE
  APROVADA
  REPROVADA
}

enum PlatformCode {
  INGRESSE
  SYMPLA
  TICKETMASTER
}

/** Ticketeira. `profile` segue o tipo RuleProfile de src/lib/rules/types.ts. */
model Platform {
  id      String       @id @default(cuid())
  code    PlatformCode @unique
  name    String
  profile Json
  events  Event[]
}

enum TransferAllowed {
  SIM
  NAO
  DESCONHECIDO
}

/**
 * Agência/promoter parceiro. Ganha parte da comissão nas vendas que indica
 * (link, página ou cupom) e nas vendas dos próprios eventos.
 */
model Partner {
  id               String   @id @default(cuid())
  /** Endereço da página: /timelapse */
  slug             String   @unique
  name             String
  /** Código de desconto/indicação digitado no checkout (ex.: TIMELAPSE). */
  couponCode       String   @unique
  logoUrl          String?
  /** Cor principal da página do parceiro (hex). */
  color            String   @default("#5b2ee6")
  /** Parte da comissão da plataforma que vai para o parceiro (5000 = 50%). */
  commissionShareBps Int    @default(5000)
  /** Desconto ao comprador quando chega pelo link/cupom, em pontos-base do valor (100 = 1%). Sai da comissão. */
  discountBps      Int      @default(0)
  /** Subconta do parceiro no gateway, para receber a parte dele no split. */
  gatewayWalletId  String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  events  Event[]
  orders  Order[]
  members PartnerMember[]
}

/** Pessoas da agência com acesso ao painel do parceiro (/parceiro). */
model PartnerMember {
  id        String   @id @default(cuid())
  partnerId String
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([partnerId, userId])
  @@index([userId])
}

model Event {
  id                   String          @id @default(cuid())
  /** Evento de um parceiro: aparece em destaque na página dele, com selo de revenda oficial. */
  partnerId            String?
  partner              Partner?        @relation(fields: [partnerId], references: [id])
  platformId           String
  platform             Platform        @relation(fields: [platformId], references: [id])
  slug                 String          @unique
  name                 String
  category             String
  /** Cor do cartaz provisório (0–360) enquanto não há imagem. */
  hue                  Int             @default(260)
  imageUrl             String?
  /** Setores e valores originais: [{ name, faceValueCents }]. */
  sectors              Json            @default("[]")
  venue                String
  city                 String
  startsAt             DateTime
  endsAt               DateTime
  isSports             Boolean         @default(false)
  transferAllowed      TransferAllowed @default(DESCONHECIDO)
  nominalBiometric     Boolean         @default(false)
  /** Data/hora exatas da janela de transferência definida pela ticketeira/produtor. */
  transferOpensAt      DateTime?
  transferEndsAt       DateTime?
  /** Só informativo: a ticketeira tem revenda oficial ligada para este evento. */
  officialResaleActive Boolean         @default(false)
  /** Sobreposições do perfil da ticketeira (Partial<RuleProfile>). */
  ruleOverrides        Json            @default("{}")
  createdAt            DateTime        @default(now())

  listings    Listing[]
  wantedPosts WantedPost[]

  @@index([startsAt])
}

enum TicketType {
  INTEIRA
  MEIA
  MEIA_SOCIAL
  CORTESIA
}

enum ListingStatus {
  ATIVO
  PAUSADO
  ESGOTADO
  /** Janela de transferência encerrada: anúncio sai do ar automaticamente. */
  ENCERRADO
  REMOVIDO
}

model Listing {
  id                          String        @id @default(cuid())
  eventId                     String
  event                       Event         @relation(fields: [eventId], references: [id])
  sellerId                    String
  seller                      User          @relation(fields: [sellerId], references: [id])
  sector                      String
  ticketType                  TicketType
  quantity                    Int
  quantityAvailable           Int
  priceCents                  Int
  faceValueCents              Int
  purchasedAt                 DateTime
  /** Número do pedido na ticketeira; só usado em disputas. */
  platformOrderRef            String
  sellerDeclaresOriginalBuyer Boolean
  status                      ListingStatus @default(ATIVO)
  createdAt                   DateTime      @default(now())

  orders Order[]

  @@index([eventId, status])
}

enum PayoutStatus {
  NENHUM
  /** Pedido liberado, mas a conta de recebimento do vendedor ainda não foi aprovada. */
  AGUARDANDO_CADASTRO
  SOLICITADO
  /** Transferência criada no Asaas, esperando a autorização no painel (ação crítica). */
  AGUARDANDO_APROVACAO
  CONCLUIDO
  FALHOU
}

enum RefundStatus {
  NENHUM
  /** Pedido enviado ao gateway, sem retorno ainda. */
  SOLICITADO
  /** Criado no Asaas, esperando a aprovação manual (ação crítica). */
  AGUARDANDO_APROVACAO
  CONCLUIDO
  /** O gateway recusou (ex.: saldo insuficiente para cobrir a taxa). */
  FALHOU
}

enum OrderStatus {
  AGUARDANDO_PAGAMENTO
  PAGO
  TRANSFERIDO
  RECEBIDO
  EM_DISPUTA
  LIBERADO
  REEMBOLSADO
  CANCELADO
}

model Order {
  id                 String      @id @default(cuid())
  listingId          String
  listing            Listing     @relation(fields: [listingId], references: [id])
  buyerId            String
  buyer              User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  quantity           Int
  totalCents         Int
  platformFeeCents   Int
  sellerNetCents     Int
  /** Taxa de serviço paga pelo comprador (somada ao preço). */
  buyerFeeCents      Int         @default(0)
  /** Comissão descontada do vendedor. */
  sellerFeeCents     Int         @default(0)
  /** Desconto do cupom/link do parceiro, sobre o total (sai da receita do site). */
  discountCents      Int         @default(0)
  /** Parte da comissão que vai para o parceiro. */
  partnerFeeCents    Int         @default(0)
  partnerId          String?
  partner            Partner?    @relation(fields: [partnerId], references: [id])
  /** Como o parceiro foi atribuído: LINK, CUPOM ou EVENTO. */
  partnerAttribution String?
  status             OrderStatus @default(AGUARDANDO_PAGAMENTO)
  /** Dados que o vendedor usa para transferir (e-mail, CPF, nome, Quentro ID). */
  buyerIdentifiers   Json
  chargeId           String?     @unique
  pixCopyPaste       String?
  /** Situação da devolução no gateway (reembolsos são aprovados manualmente no Asaas). */
  refundStatus       RefundStatus @default(NENHUM)
  refundError        String?
  refundUpdatedAt    DateTime?
  /**
   * Repasse depois do evento: o Pix fica todo na conta da plataforma e, na liberação,
   * transferimos (POST /transfers no Asaas) a parte do vendedor e a do parceiro.
   */
  payoutStatus       PayoutStatus @default(NENHUM)
  payoutError        String?
  payoutUpdatedAt    DateTime?
  /** Transferência já feita ao vendedor; evita pagar de novo ao tentar outra vez. */
  sellerTransferId   String?
  /** Transferência já feita ao parceiro (só quando ele tem subconta). */
  partnerTransferId  String?
  paymentExpiresAt   DateTime
  paidAt             DateTime?
  transferDeadlineAt DateTime?
  disputeDeadlineAt  DateTime
  releaseAt          DateTime
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  logs     OrderLog[]
  disputes Dispute[]
  messages Message[]

  @@index([status, releaseAt])
  @@index([status, transferDeadlineAt])
  @@index([status, paymentExpiresAt])
  @@index([refundStatus])
  @@index([payoutStatus])
}

/** Histórico imutável de cada mudança de status (prova em disputas e no MED). */
model OrderLog {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id])
  fromStatus OrderStatus
  toStatus   OrderStatus
  action     String
  actor      String
  actorId    String?
  note       String?
  ip         String?
  createdAt  DateTime     @default(now())

  @@index([orderId])
}

model Dispute {
  id         String    @id @default(cuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id])
  openedBy   String
  reason     String
  resolution String?
  winner     String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

/** Pedido de compra ("COMPRO ..."), como nos grupos. */
model WantedPost {
  id            String     @id @default(cuid())
  eventId       String
  event         Event      @relation(fields: [eventId], references: [id])
  buyerId       String
  buyer         User       @relation(fields: [buyerId], references: [id])
  sector        String?
  ticketType    TicketType?
  quantity      Int
  maxPriceCents Int?
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
}

enum MessageKind {
  USUARIO
  SISTEMA
  BLOQUEADA
}

/** Chat do pedido entre comprador e vendedor. Abre só depois do pagamento. */
model Message {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  senderId  String?
  sender    User?       @relation(fields: [senderId], references: [id])
  /** COMPRADOR, VENDEDOR, ADMIN ou SISTEMA */
  role      String
  kind      MessageKind @default(USUARIO)
  /** Mensagens bloqueadas ficam guardadas (visíveis só para o admin) como sinal de risco. */
  body      String
  readAt    DateTime?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

enum EmailStatus {
  ENVIADO
  REGISTRADO
  FALHOU
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

/** Todo aviso enviado (ou só registrado, sem provedor configurado). Também evita avisos repetidos. */
model EmailLog {
  id        String      @id @default(cuid())
  channel   NotificationChannel @default(EMAIL)
  /** E-mail, ou celular com DDI no WhatsApp. */
  to        String
  subject   String
  body      String
  /** Tipo do aviso (ex.: PEDIDO_PAGO_COMPRADOR, CHAT, LEMBRETE_TRANSFERENCIA). */
  kind      String
  orderId   String?
  status    EmailStatus
  error     String?
  createdAt DateTime    @default(now())

  @@index([orderId, kind, to])
}

enum WithdrawalStatus {
  SOLICITADO
  /** Esperando autorização no painel do gateway. */
  AGUARDANDO_APROVACAO
  CONCLUIDO
  FALHOU
}

/** Saque automático da conta de recebimento do vendedor para a chave Pix CPF dele. */
model SellerWithdrawal {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  cents      Int
  /** Chave Pix de destino: sempre o CPF do próprio vendedor (mesma titularidade). */
  pixKey     String
  transferId String?
  status     WithdrawalStatus
  error      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([userId, status])
}
