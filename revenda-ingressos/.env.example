# Postgres (ex.: Supabase, Neon ou local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/revenda?schema=public"

# Pagamentos: "mock" em desenvolvimento, "asaas" com credenciais do sandbox
PAYMENT_PROVIDER="mock"
ASAAS_API_URL="https://api-sandbox.asaas.com/v3"
ASAAS_API_KEY=""
# Token configurado no painel do Asaas para autenticar os webhooks
ASAAS_WEBHOOK_TOKEN=""

# Taxa de serviço do comprador (somada ao preço) e comissão do vendedor, em pontos-base (1500 = 15%)
BUYER_FEE_BPS="1500"
SELLER_FEE_BPS="0"
CRON_SECRET="troque-por-um-segredo"

# Endereço público do site (links nos e-mails)
SITE_URL="http://localhost:3000"
# E-mails via Resend (sem estas duas, os e-mails só ficam registrados na tabela EmailLog)
RESEND_API_KEY=""
EMAIL_FROM="Passe Adiante <avisos@seudominio.com.br>"
ENCRYPTION_KEY="troque-por-um-texto-longo-e-aleatorio-com-32+-caracteres"

# WhatsApp Cloud API (Meta). Sem estas duas, as mensagens só ficam registradas.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"

# Dados da empresa (vazios = os do cartão CNPJ, em src/components/legal.tsx)
COMPANY_LEGAL_NAME=""
COMPANY_CNPJ=""
COMPANY_ADDRESS=""
CONTACT_EMAIL=""
PRIVACY_EMAIL=""
# "1" depois da revisão do advogado (tira o aviso de versão preliminar)
LEGAL_REVIEWED=""

# Tarifa do Pix de saída cobrada da subconta do vendedor no saque automático (centavos)
WITHDRAWAL_FEE_CENTS="0"
