# Postgres (ex.: Supabase, Neon ou local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/revenda?schema=public"

# Pagamentos: "mock" em desenvolvimento, "asaas" com credenciais do sandbox
PAYMENT_PROVIDER="mock"
ASAAS_API_URL="https://api-sandbox.asaas.com/v3"
ASAAS_API_KEY=""
# Token configurado no painel do Asaas para autenticar os webhooks
ASAAS_WEBHOOK_TOKEN=""

# Comissão da plataforma cobrada do vendedor, em pontos-base (1000 = 10%)
PLATFORM_FEE_BPS="1000"
CRON_SECRET="troque-por-um-segredo"
